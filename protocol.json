      "default_value": {
        "sensor_id": "sensor3",
        "status": "normal",
        "value": 0.0,
        "timestamp": "1704720307.3"
      },
      "data_structure": {
        "sensor_id": "string",
        "status": "string",
        "value": "float",
        "timestamp": "string"
      }
    }
  },
  "protocol_mapping": {
    "external_status_fields": {
      "description": "对外协议状态字段映射",
      "target_topic_template": "remote_ctrl/console/equipment_status",
      "fields": {
        "status_11": {"source": "device_config", "field": "device_serial", "type": "string", "description": "设备编号", "default_value": "5"},
        "status_12": {"source": "rtk_info", "field": "longitude", "type": "float", "description": "经度", "default_value": 102.13154800381285},
        "status_13": {"source": "rtk_info", "field": "latitude", "type": "float", "description": "纬度", "default_value": 27.904670302925},
        "status_14": {"source": "rtk_info", "field": "altitude", "type": "float", "description": "高程", "default_value": 1541.74523257812},
        "status_15": {"source": "rtk_info", "field": "roll", "type": "float", "description": "横滚角", "default_value": 2.531362536152344},
        "status_16": {"source": "rtk_info", "field": "pitch", "type": "float", "description": "俯仰角", "default_value": 0.5235541609256810},
        "status_17": {"source": "rtk_info", "field": "yaw", "type": "float", "description": "偏航角", "default_value": -153.45096251959513},
        "status_18": {"source": "rtk_info", "field": "timestamp", "type": "string", "description": "时间戳", "default_value": "1704720307.3"}
      }
    },
    "internal_class_mapping": {
      "description": "对内协议类别映射",
      "target_topic_template": "up/status/{excavator_id}",
      "classes": {
        "class1": {
          "source": "can_data",
          "description": "CAN信息",
          "field_mapping": {
            "status_11": {"source_field": "status_1", "type": "float", "default_value": 0},
            "status_12": {"source_field": "status_2", "type": "bool", "default_value": true},
            "status_13": {"source_field": "status_3", "type": "bool", "default_value": true},
            "status_14": {"source_field": "unknown_1", "type": "int", "default_value": 0},
            "status_15": {"source_field": "unknown_2", "type": "int", "default_value": 0},
            "status_16": {"source_field": "unknown_3", "type": "int", "default_value": 0}
          }
        },
        "class2": {
          "source": "mqtt_data",
          "description": "RTK信息",
          "field_mapping": {
            "status_21": {"source_field": "rtk_info.longitude", "type": "float", "default_value": 102.13154800381285},
            "status_22": {"source_field": "rtk_info.latitude", "type": "float", "default_value": 27.904670302925},
            "status_23": {"source_field": "rtk_info.altitude", "type": "float", "default_value": 1541.74523257812},
            "status_24": {"source_field": "rtk_info.roll", "type": "float", "default_value": 2.531362536152344},
            "status_25": {"source_field": "rtk_info.pitch", "type": "float", "default_value": 0.5235541609256810},
            "status_26": {"source_field": "rtk_info.yaw", "type": "float", "default_value": -153.45096251959513}
          }
        },
        "class3": {
          "source": "simulation_data",
          "description": "模拟信息",
          "field_mapping": {
            "status_31": {"source_field": "status_31", "type": "int", "default_value": 0, "description": "档位状态"},
            "status_32": {"source_field": "status_32", "type": "float", "default_value": 78.3, "description": "系统状态32"},
            "status_33": {"source_field": "status_33", "type": "float", "default_value": 65.4, "description": "系统状态13"},
            "status_34": {"source_field": "status_34", "type": "float", "default_value": 61.7, "description": "系统状态14"},
            "status_35": {"source_field": "status_35", "type": "float", "default_value": 6.1, "description": "系统状态15"},
            "status_36": {"source_field": "status_36", "type": "float", "default_value": 32.0, "description": "能耗数据"}
          }
        }
      }
    }
  },
  "simulation_config": {
    "enable": true,
    "random_range": [0.1, 1.5],
    "precision": 3,
    "default_values": {
      "status_31": 0,
      "status_32": 78.3,
      "status_33": 65.4,
      "status_34": 61.7,
      "status_35": 6.1,
      "status_36": 32.0
    },
    "gear_energy_consumption": [8, 11.5, 16, 20, 23, 28, 30, 32, 34, 36, 38]
  },

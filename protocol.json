  "mqtt_to_mqtt": {
    "remote_sensor/remote_ctrl/rtk_info": {
      "target_key": "rtk_info",
      "description": "RTK定位信息",
      "default_value": {
        "longitude": 102.13154800381285,
        "latitude": 27.904670302925,
        "altitude": 1541.74523257812,
        "roll": 2.531362536152344,
        "pitch": 0.5235541609256810,
        "yaw": -153.45096251959513,
        "timestamp": "1704720307.3"
      },
      "data_structure": {
        "longitude": "float",
        "latitude": "float", 
        "altitude": "float",
        "roll": "float",
        "pitch": "float",
        "yaw": "float",
        "timestamp": "string"
      }
    },
    "sensor2": {
      "target_key": "sensor2_data",
      "description": "传感器2数据",
      "default_value": {
        "sensor_id": "sensor2",
        "status": "normal",
        "value": 0.0,
        "timestamp": "1704720307.3"
      },
      "data_structure": {
        "sensor_id": "string",
        "status": "string",
        "value": "float",
        "timestamp": "string"
      }
    },
    "sensor3": {
      "target_key": "sensor3_data",
